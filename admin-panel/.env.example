# Local development. Copy to .env.local, which is gitignored.
#
# The app itself reads no environment: it is a plain client that calls
# /api/* on its own origin. These are read by vite.config.ts alone, for the
# dev server, which in development is the admin host (FR-EDGE-6, FR-EDGE-9).
# None is VITE_-prefixed, so none reaches the bundle; scripts/check-bundle.mjs
# fails the build if gateway's address appears in dist/.
#
# None of these is a secret. The admin host holds none. All are optional:
# without this file `npm run dev` serves the app alone, with no API.
#
# This is the HTTPS topology of ../gateway/README.md (NFR-OPS-6), on the
# openfolio.test names of the hosts file. Node must trust gateway's mkcert
# certificate: start the dev server with NODE_EXTRA_CA_CERTS set (README.md).

# Where /api/* is forwarded: gateway's origin, on the hostname gateway has as
# its GATEWAY_ADMIN_HOST (../gateway/.env).
GATEWAY_ORIGIN=https://gateway.openfolio.test:8080

# The admin host's own name, a bare hostname resolving to loopback. The panel
# is then at https://<ADMIN_HOST>:5174.
ADMIN_HOST=admin.openfolio.test

# The mkcert certificate the dev server answers with. The wildcard made for
# gateway covers the admin host too.
TLS_CERT_PATH=../gateway/certs/openfolio.test.pem
TLS_KEY_PATH=../gateway/certs/openfolio.test-key.pem

# --- Plain HTTP on localhost instead (../README.md) ---
#
# Leave ADMIN_HOST and both TLS paths unset; the panel is then at
# http://localhost:5174.
# GATEWAY_ORIGIN=http://gateway.localhost:8080
