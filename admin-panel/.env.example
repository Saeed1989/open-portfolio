# admin — development environment
#
# Copy to .env.local, which is gitignored. Nothing here is VITE_-prefixed, and
# that is deliberate: Vite only exposes VITE_-prefixed variables to client
# code, so none of these can be compiled into a bundle. The dev server reads
# them in vite.config.ts and injects them into proxied requests instead.
# `npm run build` fails if any of their values appear in the output.

# ---------------------------------------------------------------------------
# How the dev server reaches `api`.
# ---------------------------------------------------------------------------
#
#   mock    (default) MSW answers in the browser. Nothing leaves the page, so
#           no api and no database are needed. This is what a fresh clone gets.
#
#   direct  The Vite proxy talks to `api` with no `edge` in between, setting
#           the same two headers `edge` would: X-Api-Key and X-User-Id.
#           Fastest loop against real data, and it needs no change to `api`.
#           It is NOT the production topology: `edge` owns host matching, the
#           identity subrequest, TLS and the rate limits (FR-EDGE-1..6), and
#           none of that is exercised here.
#
#   edge    No Vite proxy at all. Build the app and serve it through ../edge,
#           which is the arrangement FR-EDGE-6 and NFR-OPS-6 describe. Open the
#           admin host, not this port.
#
ADMIN_DEV_MODE=mock

# ---------------------------------------------------------------------------
# direct mode only — required, and the dev server refuses to start without them
# ---------------------------------------------------------------------------

# Where `api` is listening. `api` reads PORT from its own .env; 3000 is what
# data-service/.env.example ships with.
API_URL=http://127.0.0.1:3000

# `api`'s admin key — the SAME value as ADMIN_API_KEY in data-service's
# environment. The proxy presents it as X-Api-Key, which is what `edge` does
# in production; `api`'s admin guard accepts it alongside X-User-Id and
# neither alone.
#
# Treat it as a real credential. It is not a dev-only key: whoever holds it,
# paired with an X-User-Id, can act as any tenant on whatever database the api
# is pointed at. Point direct mode at a local database, never a shared one.
ADMIN_API_KEY=

# Which tenant the proxy acts as. Changing it means restarting the dev server —
# identity is fixed at startup, which is the point: the browser cannot choose
# a tenant, so a bug in the app cannot become cross-tenant access.
#
#   alice   the happy path — published, all four Must sections complete, four
#           projects and twelve skills. Use this unless you need otherwise.
#   bob     a second real tenant whose every field differs from alice's, so a
#           cross-tenant leak fails on whichever field a test asserts on.
#   carol   draft only, deliberately incomplete — two projects against a
#           minimum of three, three prominent skills against a band of five to
#           eight. Publish validation has something real to fail on.
#   dave    suspended, and published on purpose: a suspended tenant with no
#           published tree would 404 for the wrong reason.
#
# `npm run seed` in data-service creates all four.
DEV_TENANT=alice

# Overrides DEV_TENANT for a tenant you created by hand. A 24-character hex
# ObjectId; the admin guard 401s on anything else.
# DEV_USER_ID=
