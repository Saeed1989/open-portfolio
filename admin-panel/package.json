{
  "name": "@openportfolio/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src",
    "build:mock": "tsc --noEmit && vite build --mode mock && node scripts/check-bundle.mjs",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@portfolio/registry": "file:../packages/registry",
    "@tanstack/react-query": "5.66.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/ibm-plex-sans": "5.1.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.10.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "eslint": "9.19.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "msw": "2.7.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
