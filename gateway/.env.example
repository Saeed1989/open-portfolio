# gateway — every value it takes. Copy to .env, which is gitignored.
# All of these are validated at boot; gateway refuses to start on a bad one.
# One is a secret: GATEWAY_API_KEY, the only one gateway holds.

# The two hosts gateway answers, matched exactly. Any other Host gets a closed
# connection and no response. Bare hostnames: no scheme, no port.
#
# GATEWAY_ADMIN_HOST is gateway's own hostname, not the admin host's: the
# admin host (localhost:5174 in development) serves the SPA and forwards
# /api/* here. No browser-facing URL names it.
GATEWAY_ADMIN_HOST=gateway.localhost
PUBLIC_READ_HOST=api.localhost

# Where api is reached. An origin, with no path. It need not be
# private or local.
API_UPSTREAM=http://127.0.0.1:3001

# Sent to api as X-Api-Key on every request: base64url,
# at least 32 bytes decoded. It must be one of GATEWAY_API_KEYS in
# ../data-service/.env. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_API_KEY=REPLACE_ME

PORT=8080

# TLS termination. Set both paths and gateway serves HTTPS
# itself; leave both empty and it serves plain HTTP — in development, or
# behind a load balancer.
TLS_CERT_PATH=
TLS_KEY_PATH=

# The peers whose X-Forwarded-For and X-Forwarded-Proto are believed:
# comma-separated addresses or CIDRs — the admin host's egress
# addresses, and a load balancer's if there is one. The client address is then
# the rightmost entry that is not in this list. From any other peer the header
# is ignored and the peer address is used. Empty: nobody's is believed.
# In development the admin dev server runs on this machine.
TRUSTED_PROXY_CIDRS=127.0.0.1

# Rate limits, per client IP: at most MAX requests per WINDOW_MS. Exceeding
# one answers 429 without calling api.
#
# OAUTH   /api/auth/google/start and /callback (the stricter one)
# AUTH    every other /api/auth/* path
# PUBLIC  the public-read host
RATE_LIMIT_OAUTH_MAX=10
RATE_LIMIT_OAUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=600
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
