# edge — every value it takes (FR-EDGE-6). Copy to .env, which is gitignored.
# All of these are validated at boot; edge refuses to start on a bad one.
# None is a secret: edge holds no application secret (FR-EDGE-7).

# The two hosts edge answers, matched exactly. Any other Host gets a closed
# connection and no response (FR-EDGE-1). Bare hostnames: no scheme, no port.
ADMIN_HOST=admin.openfolio.test
PUBLIC_READ_HOST=api.openfolio.test

# api's private address (FR-EDGE-5). An origin, with no path.
API_UPSTREAM=http://127.0.0.1:3001

# The admin SPA build. Must contain index.html.
ADMIN_DIST_DIR=../admin-panel/dist

PORT=443

# TLS termination (SRS §10.3 Q24) — one of two modes.
#
#   In-process: set both paths. edge serves HTTPS and believes nobody's
#   X-Forwarded-For; TRUSTED_PROXY_CIDRS must then be empty.
#
#   Behind a load balancer: leave both empty. edge serves plain HTTP and
#   believes X-Forwarded-For and X-Forwarded-Proto only from the peers listed
#   in TRUSTED_PROXY_CIDRS (comma-separated addresses or CIDRs).
TLS_CERT_PATH=./certs/openfolio.test.pem
TLS_KEY_PATH=./certs/openfolio.test-key.pem
TRUSTED_PROXY_CIDRS=

# Rate limits, per client IP: at most MAX requests per WINDOW_MS. Exceeding
# one answers 429 without calling api.
#
# OAUTH   /api/auth/google/start and /callback (FR-AUTH-16, the stricter one)
# AUTH    every other /api/auth/* path (FR-AUTH-16)
# PUBLIC  the public-read host (SRS §10.3 Q23)
RATE_LIMIT_OAUTH_MAX=10
RATE_LIMIT_OAUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=600
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
