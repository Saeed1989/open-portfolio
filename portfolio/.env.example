# Copy to .env.local. Nothing here is a NEXT_PUBLIC_ variable: every value is
# read on the server only, and none of it reaches the browser.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------

# Base URL of the public API surface. lib/api.ts appends
# /public/portfolios/<slug>. Required unless USE_FIXTURES=true.
PORTFOLIO_API_URL=https://api.site.com

# Development only — ignored when NODE_ENV=production. Replaces the network
# entirely with fixtures/portfolios/<slug>.json, falling back to default.json
# for an unknown slug. Also disables per-slug caching, so editing a fixture
# shows on the next refresh.
USE_FIXTURES=true

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------

# Where the tenant comes from.
#
#   host  (default)  The Host header decides, per FR-TEN-2. alice.localhost:3000
#                    serves `alice`; plain localhost:3000 has no label and falls
#                    back to DEV_SLUG in development only.
#   env              DEV_SLUG decides and the Host header is ignored, so
#                    localhost:3000 serves one tenant at the root with no
#                    subdomain. It overrides a label too: with this set,
#                    alice.localhost:3000 still serves DEV_SLUG.
#
# `env` applies only to hosts served from this machine (localhost, *.localhost,
# 127.0.0.1, [::1]). Any other host resolves from Host regardless, so setting
# this in a deployment cannot pin the site to a single tenant.
TENANT_SOURCE=host

# The tenant for TENANT_SOURCE=env, and the development fallback for plain
# localhost:3000 under TENANT_SOURCE=host.
#   fixtures: default | minimal | sparse | saeed
#   seeded API tenants: alice | bob | dave   (carol is unpublished -> 404)
DEV_SLUG=default

# NOTE: middleware runs in the edge runtime, where Next inlines process.env at
# BUILD time. `next dev` picks these up on restart, but `next build` bakes them
# in — change either value and rebuild before `next start`.

# ---------------------------------------------------------------------------
# Cache invalidation
# ---------------------------------------------------------------------------

# Shared secret for POST /api/internal/revalidate, sent by the API after a
# publish as `Authorization: Bearer <secret>`. An unset value fails closed —
# the endpoint returns 401 rather than revalidating.
REVALIDATE_SECRET=change-me
