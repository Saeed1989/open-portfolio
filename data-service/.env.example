NODE_ENV=development
PORT=3001
MONGODB_USERNAME="x"
MONGODB_PASSWORD="x"
MONGODB_URI=mongodb://localhost:27017/portfolio

# Server URL listed in both Swagger documents.
API_BASE_URL=http://localhost:3001

# Stubbed dependencies (src/external). Switching to the real implementation
# changes these values and nothing else.
REVALIDATE_MODE=noop
STORAGE_MODE=local

# Shared secret proving an admin request came from `edge` (FR-AUTH-12).
# The tenant comes from the X-User-Id header edge sets beside it, never from
# this key.
ADMIN_API_KEY=dev-admin-api-key

# Auth module (src/auth). Boot fails if any required value is missing or
# malformed.
# Origin of the admin host, no trailing slash. OAuth redirect URIs are
# ${ADMIN_ORIGIN}/api/auth/{github|google}/callback.
ADMIN_ORIGIN=https://admin.openfolio.test
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Access JWT signing key, HS256 (FR-AUTH-19). Keys are base64 and decode to
# at least 32 bytes: `openssl rand -base64 32`. The previous pair is optional,
# and is set only while a rotation is in flight.
ACCESS_JWT_CURRENT_KID=k1
ACCESS_JWT_CURRENT_KEY=
ACCESS_JWT_PREVIOUS_KID=
ACCESS_JWT_PREVIOUS_KEY=
# AES-256-GCM key for the stored provider token (NFR-SEC-3): base64, exactly
# 32 bytes decoded. `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=
