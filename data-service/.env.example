NODE_ENV=development
PORT=3001
MONGODB_USERNAME="x"
MONGODB_PASSWORD="x"
MONGODB_URI=mongodb://localhost:27017/portfolio

# Server URL listed in both Swagger documents.
API_BASE_URL=http://localhost:3001

# Stubbed dependencies (src/external). Switching to the real implementation
# changes these values and nothing else.
REVALIDATE_MODE=noop
STORAGE_MODE=local

# Interface the server binds. Loopback by default. Where it binds is not what
# protects /auth/* and /admin/*: GATEWAY_API_KEYS below is (FR-EDGE-5).
API_BIND_HOST=127.0.0.1

# Keys gateway may present as X-Api-Key (FR-EDGE-5, FR-EDGE-8): a JSON array
# of one base64url key of at least 32 bytes, or two during a rotation. /auth/*
# and /admin/* answer 401 without one. It must hold GATEWAY_API_KEY of
# ../gateway/.env, and no key may also be an AUTH_JWT_KEYS key. The server
# refuses to start if these break the rules. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_API_KEYS=["REPLACE_ME"]

# Google OAuth client (FR-AUTH-1, FR-AUTH-9). The redirect URI is the public
# callback, on the admin host: https://<admin host>/api/auth/google/callback.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://admin.openfolio.test:5174/api/auth/google/callback

# Access-JWT signing keys (FR-AUTH-19): a JSON object mapping kid to a
# base64url key of at least 32 bytes, with at most two entries — the current
# key and, during a rotation, the previous one. The server refuses to start
# if these break the rules. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_KEYS={"k1":"REPLACE_ME"}
AUTH_JWT_CURRENT_KID=k1
