  "info": {
    "title": "Portfolio API — admin",
    "description": "Session-authenticated. Reads and writes the draft of the session's portfolio (SRS §7.2).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "google"
            ],
            "example": "github"
          },
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Alice Doe"
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://avatars.githubusercontent.com/u/1"
          }
        },
        "required": [
          "provider",
          "email",
          "displayName"
        ]
      },
      "AdminSectionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "hero",
              "projects",
              "skills",
              "contact",
              "experience",
              "education",
              "blog",
              "testimonials",
              "opensource",
              "speaking",
              "achievements",
              "trainings",
              "gallery"
            ],
            "example": "projects"
          },
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "content": {
            "type": "object",
            "additionalProperties": true,
            "description": "Shaped by the registry's descriptor for `type`.",
            "example": {
              "items": []
            }
          }
        },
        "required": [
          "type",
          "enabled",
          "order",
          "content"
        ]
      },
      "AdminThemeDto": {
        "type": "object",
        "properties": {
          "accent": {
            "type": "string",
            "example": "#2f5bff"
          },
          "mode": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ],
            "example": "system"
          },
          "fontPairing": {
            "type": "string",
            "example": "grotesk-spline"
          }
        }
      },
      "AdminSeoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Alice Doe — Full-stack engineer"
          },
          "description": {
            "type": "string",
            "example": "I build fast, accessible web products."
          },
          "keywords": {
            "example": [
              "full-stack engineer",
              "performance"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ogImageAssetId": {
            "type": "string",
            "description": "Media asset id of an uploaded OG image.",
            "example": "66e1f0c2a1b2c3d4e5f60718"
          }
        }
      },
      "AdminAnalyticsDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "plausible",
              "ga"
            ],
            "example": "plausible"
          },
          "id": {
            "type": "string",
            "example": "alice.site.com"
          }
        },
        "required": [
          "provider",
          "id"
        ]
      },
      "DraftDto": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminSectionDto"
            }
          },
          "theme": {
            "$ref": "#/components/schemas/AdminThemeDto"
          },
          "seo": {
            "$ref": "#/components/schemas/AdminSeoDto"
          },
          "analytics": {
            "nullable": true,
            "description": "Null until the tenant configures one.",
            "allOf": [
              {
                "$ref": "#/components/schemas/AdminAnalyticsDto"
              }
            ]
          }
        },
        "required": [
          "sections",
          "theme",
          "seo",
          "analytics"
        ]
      },
      "AdminPortfolioDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "alice"
          },
          "status": {
            "type": "string",
            "enum": [
              "unpublished",
              "published",
              "suspended"
            ],
            "example": "unpublished"
          },
          "registryVersion": {
            "type": "number",
            "example": 2
          },
          "presetId": {
            "type": "string",
            "example": "developer"
          },
          "draft": {
            "$ref": "#/components/schemas/DraftDto"
          },
          "publishedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "example": "2026-09-01T10:00:00.000Z"
          },
          "version": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "slug",
          "status",
          "registryVersion",
          "draft",
          "version"
        ]
      },
      "UpdateSlugDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "alice"
          }
        },
        "required": [
          "slug"
        ]
      },
      "UpdateSectionDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "order": {
            "type": "number",
            "example": 2
          },
          "content": {
            "type": "object",
            "additionalProperties": true,
            "description": "Replacement content, shaped by the registry's descriptor for :type.",
            "example": {
              "items": []
            }
          }
        }
      },
      "CreateUploadUrlDto": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "example": "image/png"
          },
          "bytes": {
            "type": "number",
            "example": 482133
          },
          "altText": {
            "type": "string",
            "description": "Required at upload time (FR-MED-5).",
            "example": "Screenshot of the dashboard"
          }
        },
        "required": [
          "mimeType",
          "bytes",
          "altText"
        ]
      },
      "UploadUrlDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "example": "66e1f0c2a1b2c3d4e5f60718"
          },
          "uploadUrl": {
            "type": "string",
            "description": "Short-lived; the browser uploads directly to it (FR-MED-1).",
            "example": "https://storage.site.com/uploads/abc?signature=xyz"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-01T10:05:00.000Z"
          }
        },
        "required": [
          "assetId",
          "uploadUrl",
          "expiresAt"
        ]
      },
      "IntegrationCacheDto": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "example": {}
          },
          "fetchedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-01T06:00:00.000Z"
          },
          "stale": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "payload",
          "fetchedAt",
          "stale"
        ]
      },
      "IntegrationDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "rss",
              "x",
              "linkedin"
            ],
            "example": "github"
          },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "username": "alice"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failing",
              "revoked"
            ],
            "example": "ok"
          },
          "lastSyncAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "example": "2026-09-01T06:00:00.000Z"
          },
          "lastError": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "consecutiveFailures": {
            "type": "number",
            "example": 0
          },
          "cache": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/IntegrationCacheDto"
              }
            ]
          }
        },
        "required": [
          "provider",
          "config",
          "status",
          "consecutiveFailures",
          "cache"
        ]
      },
      "CredlyImportDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Public Credly profile username.",
            "example": "alice-doe"
          }
        },
        "required": [
          "username"
        ]
      },
      "CredlyBadgeDto": {
        "type": "object",
        "properties": {
          "embedCode": {
            "type": "string",
            "description": "Pasted Credly embed code. Only the badge identifier is kept; the markup is never stored (FR-INT-14).",
            "example": "<div data-share-badge-id=\"8f0e4a2c-1b3d-4e5f-9a6b-7c8d9e0f1a2b\"></div>"
          }
        },
        "required": [
          "embedCode"
        ]
      },
      "ConnectIntegrationDto": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": true,
            "description": "Per provider: `{ username }`, `{ feedUrl }`, ... (§5.4).",
            "example": {
              "feedUrl": "https://alice.dev/rss.xml"
            }
          }
        },
        "required": [
          "config"
        ]
      },
      "PublishResultDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "example": 4
          },
          "publishedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-01T10:00:00.000Z"
          }
        },
        "required": [
          "version",
          "publishedAt"
        ]
      },
      "LinkHealthDto": {
        "type": "object",
        "properties": {
          "sectionType": {
            "type": "string",
            "enum": [
              "hero",
              "projects",
              "skills",
              "contact",
              "experience",
              "education",
              "blog",
              "testimonials",
              "opensource",
              "speaking",
              "achievements",
              "trainings",
              "gallery"
            ],
            "example": "projects"
          },
          "itemId": {
            "type": "string",
            "example": "66e1f0c2a1b2c3d4e5f60718"
          },
          "url": {
            "type": "string",
            "example": "https://demo.alice.dev"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "broken",
              "unchecked"
            ],
            "example": "ok"
          },
          "statusCode": {
            "type": "number",
            "example": 200
          },
          "lastCheckedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-01T03:00:00.000Z"
          },
          "consecutiveFailures": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "sectionType",
          "itemId",
          "url",
          "state",
          "consecutiveFailures"
        ]
      }
    }
  }
}
