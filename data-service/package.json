{
  "name": "@openportfolio/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "npm run build && node --env-file=.env dist/seed/seed.js",
    "seed:reset": "npm run build && node --env-file=.env dist/seed/seed.js --reset",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && prettier --check src",
    "format": "prettier --write src",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "vendor:registry": "node scripts/vendor-registry.mjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/mongoose": "10.1.0",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@portfolio/registry": "file:./vendor/registry",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie": "1.0.2",
    "google-auth-library": "11.2.0",
    "jose": "5.10.0",
    "mongoose": "8.24.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.2",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "nock": "14.0.17",
    "prettier": "3.9.6",
    "supertest": "7.1.4",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0"
  }
}
